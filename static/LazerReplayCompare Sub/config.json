{
    // What this overlay shows. Saved changes apply while it runs.
    //
    // item: score       score (osu!stable: ScoreV1, osu!lazer: lazer's score)
    //       score_acc   score as a share of the best score possible so far (every judgement MAX)
    //       acc         accuracy, as the game shows it
    //       stable_acc  osu!stable's accuracy from the judgements (handy while playing osu!lazer)
    //       lazer_acc   osu!lazer's accuracy from the judgements (handy while playing osu!stable)
    //       or a key from lazerReplayCompareShared/metrics.json, or off
    // show: diff        live minus the compared replay at the same note
    //       value       the live value
    //       target      the compared replay's value at the same note
    "item": "acc",
    "show": "value"
}
