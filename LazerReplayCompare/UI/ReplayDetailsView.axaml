<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LazerReplayCompare"
             x:Class="LazerReplayCompare.ReplayDetailsView"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="TextBlock.statLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.statValue">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.smallValue">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="Border.tag TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
    </Style>
    <Style Selector="Border.tag.client">
      <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
    </Style>
    <Style Selector="Border.tag.client TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.columnChip">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.columnChip.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}" />
    </Style>
    <Style Selector="Button.jump">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.infoBox">
      <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="Content" MaxWidth="1160" Margin="28,22,28,32" Spacing="18">

      <!-- Back and sections -->
      <Grid x:Name="NavRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="10">
        <Button Click="Back" MinHeight="36" Padding="12,0" ToolTip.Tip="Back to the replays (mouse back button, Backspace, Esc or Alt+Left)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round"
                  Stroke="{DynamicResource TextBrush}" Data="M15,6 L9,12 L15,18" VerticalAlignment="Center" />
            <TextBlock Text="Replays" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <WrapPanel Grid.Column="2" ItemSpacing="6" LineSpacing="6" IsVisible="{Binding HasAnalysis}">
          <TextBlock Classes="muted" FontSize="13" Text="Jump to" VerticalAlignment="Center" Margin="0,0,4,0" />
          <Button Classes="jump" Content="Timing" Click="ShowTiming" />
          <Button Classes="jump" Content="Over the song" Click="ShowSong" />
          <Button Classes="jump" Content="Long notes" Click="ShowLongNotes" IsVisible="{Binding HasHolds}" />
        </WrapPanel>
      </Grid>

      <!-- Summary -->
      <Border Classes="surface" Classes.glass="{Binding $parent[Window].DataContext.ShowBackdrop}" Padding="24">
        <StackPanel Spacing="18">
          <Grid x:Name="SummaryRow" ColumnDefinitions="*,Auto" ColumnSpacing="24" RowSpacing="16">
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="secondary" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
              <WrapPanel ItemSpacing="6" LineSpacing="6" Margin="0,4,0,0">
                <Border Classes="tag client"><TextBlock Text="{Binding ClientText}" /></Border>
                <Border Classes="tag" IsVisible="{Binding HasAnalysis}"><TextBlock Text="{Binding KeysText}" /></Border>
                <Border Classes="tag" IsVisible="{Binding HasAnalysis}"><TextBlock Text="{Binding OdText}" /></Border>
                <Border Classes="tag"><TextBlock Text="{Binding ModsText}" /></Border>
                <Border Classes="tag" IsVisible="{Binding HasAnalysis}"><TextBlock Text="{Binding RateText}" /></Border>
                <TextBlock Classes="muted" FontSize="12" Text="{Binding PlayerDateText}" VerticalAlignment="Center" Margin="4,0,0,0" />
              </WrapPanel>
            </StackPanel>
            <WrapPanel Grid.Column="1" ItemSpacing="28" LineSpacing="10" VerticalAlignment="Center">
              <StackPanel Spacing="2">
                <TextBlock Classes="statLabel" Text="{Binding ScoreLabel}" HorizontalAlignment="Right" />
                <TextBlock Classes="statValue" Text="{Binding ScoreText}" HorizontalAlignment="Right" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Classes="statLabel" Text="Accuracy" HorizontalAlignment="Right" />
                <TextBlock Classes="statValue" Text="{Binding AccuracyText}" HorizontalAlignment="Right" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Classes="statLabel" Text="MAX : 300" HorizontalAlignment="Right" />
                <TextBlock Classes="statValue" HorizontalAlignment="Right">
                  <Run Text="{Binding MaRatioText}" />
                  <Run Text="{Binding MaRatioSuffix}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                </TextBlock>
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Classes="statLabel" Text="Max combo" HorizontalAlignment="Right" />
                <TextBlock Classes="statValue" Text="{Binding MaxComboText}" HorizontalAlignment="Right" />
              </StackPanel>
            </WrapPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="14">
            <Panel Width="76" Height="76">
              <local:JudgementDonut Segments="{Binding Judgements}" Thickness="11" Track="{DynamicResource ChipBrush}" />
              <TextBlock Classes="mono" FontSize="13" FontWeight="SemiBold" Text="{Binding JudgementTotalText}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Panel>
            <local:JudgementLegendPanel Segments="{Binding Judgements}" VerticalAlignment="Center" />
          </StackPanel>

          <Border BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="80" Height="3" MinHeight="3" IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />
                <TextBlock Classes="muted" FontSize="13" Text="Analysing the replay…" IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round"
                      Stroke="{DynamicResource GoodTextBrush}" Data="M5,12.5 L9.5,17 L19,7.5" IsVisible="{Binding StatusMatches}" VerticalAlignment="Center" />
                <TextBlock FontSize="13" Foreground="{DynamicResource GoodTextBrush}" Text="{Binding StatusText}" IsVisible="{Binding StatusMatches}" VerticalAlignment="Center" />
                <TextBlock FontSize="13" Foreground="{DynamicResource WarningTextBrush}" Text="{Binding StatusText}" IsVisible="{Binding StatusDiffers}" VerticalAlignment="Center" />
                <TextBlock FontSize="13" Foreground="{DynamicResource WarningTextBrush}" Text="{Binding ErrorText}" IsVisible="{Binding ShowError}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasVsTarget}">
                <TextBlock FontSize="13" Foreground="{DynamicResource TargetLabelBrush}" Text="vs target" />
                <TextBlock Classes="secondary mono" FontSize="13" Text="{Binding VsTargetText}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Show file" Click="ShowFile" IsEnabled="{Binding HasReplay}" MinHeight="38" />
                <Button Classes="primary" Content="{Binding PinText}" Click="Pin" IsEnabled="{Binding HasReplay}" MinHeight="38" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- No replay file -->
      <Border Classes="surface" Classes.glass="{Binding $parent[Window].DataContext.ShowBackdrop}" Padding="32" MinHeight="160" IsVisible="{Binding ShowNoReplay}">
        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="No replay file" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Classes="secondary" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                     Text="osu!stable lists this score in scores.db, but its replay is missing from Data/r: there are no presses to analyse." />
        </StackPanel>
      </Border>

      <!-- Hit error distribution -->
      <Border x:Name="TimingSection" Classes="surface" Classes.glass="{Binding $parent[Window].DataContext.ShowBackdrop}" Padding="24" IsVisible="{Binding HasAnalysis}">
        <Grid x:Name="TimingRow" ColumnDefinitions="*,280" ColumnSpacing="28" RowSpacing="24">
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Classes="sectionTitle" Text="Hit error distribution" />
              <TextBlock Classes="caption" Text="{Binding HistogramSubtitle}" />
            </StackPanel>
            <local:JudgementKeyRow>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <StackPanel Width="9" Height="15" Spacing="1" VerticalAlignment="Center">
                  <Border Height="5" Background="{DynamicResource JudgementPerfectBrush}" CornerRadius="2,2,0,0" />
                  <Border Height="9" Background="{DynamicResource JudgementGreatBrush}" />
                </StackPanel>
                <TextBlock Classes="secondary" FontSize="12" Text="Long notes judged differently" VerticalAlignment="Center" />
              </StackPanel>
            </local:JudgementKeyRow>
            <local:HitHistogramChart Height="262" Bins="{Binding HistogramBins}" Mean="{Binding PressMean}" MeanLabel="{Binding PressMeanLabel}"
                                     Ticks="{Binding HistogramTicks}" StackedLabel="Long note" />
            <Grid ColumnDefinitions="*,Auto,*">
              <TextBlock FontSize="12" Foreground="{DynamicResource EarlyBrush}" Text="← early (ms)" />
              <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="{Binding OffChartText}" IsVisible="{Binding HasOffChart}" />
              <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource LateBrush}" Text="late →" HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="16">
            <StackPanel Spacing="8">
              <TextBlock Classes="caption" Text="Early vs late" />
              <local:SegmentBar Height="10" Segments="{Binding EarlyLateSegments}" Title="Presses" />
              <Grid ColumnDefinitions="*,*">
                <TextBlock FontSize="13">
                  <Run Text="Early" Foreground="{DynamicResource EarlyBrush}" />
                  <Run Text="{Binding EarlyCountText}" FontWeight="Bold" />
                  <Run Text="{Binding EarlyShareText}" Foreground="{DynamicResource TextMutedBrush}" />
                </TextBlock>
                <TextBlock Grid.Column="1" FontSize="13" HorizontalAlignment="Right">
                  <Run Text="Late" Foreground="{DynamicResource LateBrush}" />
                  <Run Text="{Binding LateCountText}" FontWeight="Bold" />
                  <Run Text="{Binding LateShareText}" Foreground="{DynamicResource TextMutedBrush}" />
                </TextBlock>
              </Grid>
            </StackPanel>
            <UniformGrid Columns="2" RowSpacing="12" ColumnSpacing="12">
              <StackPanel Spacing="2"><TextBlock Classes="statLabel" Text="Mean" /><TextBlock Classes="smallValue" Text="{Binding MeanText}" /></StackPanel>
              <StackPanel Spacing="2"><TextBlock Classes="statLabel" Text="Median" /><TextBlock Classes="smallValue" Text="{Binding MedianText}" /></StackPanel>
              <StackPanel Spacing="2"><TextBlock Classes="statLabel" Text="Unstable rate" /><TextBlock Classes="smallValue" Text="{Binding UnstableRateText}" /></StackPanel>
              <StackPanel Spacing="2"><TextBlock Classes="statLabel" Text="On time (0 ms)" /><TextBlock Classes="smallValue" Text="{Binding OnTimeText}" /></StackPanel>
            </UniformGrid>
            <Border Classes="infoBox" IsVisible="{Binding HasOffsetHint}">
              <StackPanel Spacing="6">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}" Text="Offset hint" />
                <TextBlock FontSize="14" TextWrapping="Wrap">
                  <Run Text="{Binding OffsetHintShift}" />
                  <Run Text="→" />
                  <Run Text="{Binding OffsetHintGain}" FontWeight="Bold" />
                  <Run Text="{Binding OffsetHintCounts}" />
                </TextBlock>
                <TextBlock Classes="secondary" FontSize="12" Text="Estimate, notes only" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Over the song -->
      <Border x:Name="SongSection" Classes="surface" Classes.glass="{Binding $parent[Window].DataContext.ShowBackdrop}" Padding="24" IsVisible="{Binding HasAnalysis}">
        <StackPanel Spacing="14">
          <Grid x:Name="SongHeader" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="10">
            <StackPanel Spacing="4">
              <TextBlock Classes="sectionTitle" Text="Over the song" />
              <TextBlock Classes="caption" Text="Every press · above 0 = late, below = early · top edge = not pressed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
              <TextBlock Classes="caption" Text="Highlight column" VerticalAlignment="Center" Margin="0,0,4,0" />
              <ItemsControl ItemsSource="{Binding ColumnChips}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:ColumnChip">
                    <Button Classes="columnChip" Classes.selected="{Binding IsSelected}" Content="{Binding Label}" Click="PickColumn" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
          <local:HitScatterChart x:Name="PressChart" Height="362" Points="{Binding PressPoints}" Marks="{Binding UnpressedMarks}" Edges="{Binding WindowEdges}"
                                 Range="{Binding PressRange}" Length="{Binding SongLength}" HighlightColumn="{Binding HighlightColumn}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <local:JudgementKeyRow>
              <TextBlock Classes="muted" FontSize="12" Text="· lines: window edges" VerticalAlignment="Center" />
            </local:JudgementKeyRow>
            <TextBlock Grid.Column="1" Classes="secondary" FontSize="13" Text="{Binding MissText}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Long notes -->
      <Border x:Name="LongNotesSection" Classes="surface" Classes.glass="{Binding $parent[Window].DataContext.ShowBackdrop}" Padding="24" IsVisible="{Binding HasHolds}">
        <StackPanel Spacing="18">
          <StackPanel Spacing="4">
            <TextBlock Classes="sectionTitle" Text="Long notes" />
            <TextBlock Classes="caption" Text="{Binding LongNotesSubtitle}" />
          </StackPanel>
          <Grid x:Name="LongNotesRow" ColumnDefinitions="*,*" ColumnSpacing="28" RowSpacing="20">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="28">
                <StackPanel Spacing="2"><TextBlock Classes="statLabel" Text="Head" /><TextBlock FontSize="20" FontWeight="Bold" Text="{Binding HeadMeanText}" /></StackPanel>
                <StackPanel Spacing="2"><TextBlock Classes="statLabel" Text="Release" /><TextBlock FontSize="20" FontWeight="Bold" Text="{Binding ReleaseMeanText}" /></StackPanel>
                <StackPanel Spacing="2"><TextBlock Classes="statLabel" Text="Let go early" /><TextBlock FontSize="20" FontWeight="Bold" Text="{Binding EarlyReleaseText}" /></StackPanel>
              </StackPanel>
              <TextBlock Classes="secondary" FontSize="13" Text="{Binding ReleaseSubtitle}" />
              <local:HitHistogramChart Height="150" Bins="{Binding ReleaseBins}" Ticks="{Binding ReleaseTicks}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="14">
              <TextBlock Classes="secondary" FontSize="13" Text="Judgement share: notes vs long notes" />
              <ItemsControl ItemsSource="{Binding ShareRows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="14" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:ShareRow">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Label}" />
                        <TextBlock Grid.Column="1" Classes="muted" FontSize="13" Text="{Binding Detail}" />
                      </Grid>
                      <local:SegmentBar Height="14" Segments="{Binding Segments}" Title="{Binding Label}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>

          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Classes="secondary" FontSize="13" Text="{Binding ReleaseDotsSubtitle}" VerticalAlignment="Center" />
              <local:JudgementKeyRow Grid.Column="1">
                <TextBlock Classes="muted" FontSize="12" Text="{Binding HeldText}" VerticalAlignment="Center" />
              </local:JudgementKeyRow>
            </Grid>
            <local:HitScatterChart Height="222" Points="{Binding ReleasePoints}" Marks="{Binding HeldMarks}" Range="{Binding ReleaseRange}" Length="{Binding SongLength}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="muted" FontSize="12" Text="{Binding FooterText}" IsVisible="{Binding HasAnalysis}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
